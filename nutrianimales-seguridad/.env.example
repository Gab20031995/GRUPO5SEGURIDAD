# =====================================================================
#  .env.example — valores de EJEMPLO. NO contiene credenciales reales.
#  Copiar:  cp .env.example .env  &&  chmod 600 .env
#  (scripts/setup.sh lo hace y genera contraseñas aleatorias)
# =====================================================================

# --- PostgreSQL (rotación: cada 6 meses) ---
POSTGRES_PASSWORD=cambiar_postgres_password
AGENTE_IA_PASSWORD=cambiar_agente_ia_password
MONITOR_PASSWORD=cambiar_monitor_password
GERENTE_DB_PASSWORD=cambiar_gerente_password
TI_DB_PASSWORD=cambiar_ti_password
AUDITOR_DB_PASSWORD=cambiar_auditor_password

# --- N8N (rotación de N8N_PASSWORD: cada 90 días) ---
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=cambiar_por_cadena_aleatoria_larga
# Contraseña de la cuenta propietaria de N8N (se crea en el primer ingreso)
N8N_PASSWORD=cambiar_n8n_password
# URL pública para webhooks. En local: https://localhost:8443/
# Con el bot de Telegram: la URL https://xxxx.trycloudflare.com/ del túnel
N8N_WEBHOOK_URL=https://localhost:8443/
# Token compartido entre el monitor del host y el webhook de N8N
MONITOR_WEBHOOK_TOKEN=cambiar_token_webhook

# --- pgAdmin ---
PGADMIN_EMAIL=admin@nutrianimales.local
PGADMIN_PASSWORD=cambiar_pgadmin_password

# --- Telegram (TELEGRAM_BOT_TOKEN: rotar si se compromete el bot) ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat o grupo donde llegan las alertas (número, los grupos empiezan con -100)
TELEGRAM_CHAT_ID=-1001234567890

# --- Groq (rotación: cada 90 días o si se filtra) ---
GROQ_API_KEY=gsk_ejemplo_no_real
