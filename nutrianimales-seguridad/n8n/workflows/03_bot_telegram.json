    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT '{{ $json.message.chat.id }}'::text AS chat_id, monitor.rol_usuario_bot({{ $json.message.chat.id }}) AS rol;",
        "options": {}
      },
      "id": "d8e5c1fd-c91f-47f3-b1c9-1fd3d5233511",
      "name": "Rol del usuario",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        400
      ],
      "credentials": {
        "postgres": {
          "id": "cred-pg-monitor",
          "name": "PG Monitor (monitor_n8n)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// 1) Identifica al usuario de Telegram y recupera su rol desde la BD (nodo previo).\n// 2) Marca como no admisible cualquier entrada que intente colar sintaxis SQL,\n//    en lugar de ejecutarla. Lo que se bloquea queda registrado en auditoría.\nconst roles = {};\nfor (const it of ($items(\"Rol del usuario\") || [])) {\n  const r = it.json || {};\n  if (r.chat_id) roles[String(r.chat_id)] = r.rol;\n}\nconst indicadores = [\n  /;/, /--/, /\\/\\*/, /\\bunion\\b/i,\n  /\\b(drop|delete|truncate|alter|insert|update|grant|revoke|create|copy|call|merge)\\b/i,\n  /'\\s*or\\s+/i,\n];\nconst out = [];\nfor (const item of $input.all()) {\n  const m = item.json.message || {};\n  const chat_id = Number(m.chat && m.chat.id);\n  if (!Number.isInteger(chat_id)) continue;\n  const pregunta = String(m.text || '').trim().slice(0, 300);\n  const usuario = (m.from && (m.from.username || m.from.first_name)) || 'desconocido';\n  const rol = roles[String(chat_id)] || null;\n  const admisible = pregunta.length > 0 && !indicadores.some((re) => re.test(pregunta));\n  const payload = { chat_id: String(chat_id), usuario, pregunta, rol,\n                    motivo: !rol ? 'usuario no autorizado' : (!admisible ? 'entrada con sintaxis SQL' : null) };\n  out.push({ json: { ...payload, ok: !!rol && admisible,\n                     b64: Buffer.from(JSON.stringify(payload), 'utf8').toString('base64') } });\n}\nreturn out;"
      },
      "id": "2f5340ca-7f2b-4e8c-8b3e-fa5b43736e04",
      "name": "Inspeccionar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "3eb83f83-49f2-4c78-acc7-ac6902d34255",
      "name": "¿Autorizado y válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: {\n  chat_id: r.chat_id, usuario: r.usuario, rol: r.rol, pregunta: r.pregunta,\n  body: {\n    model: 'llama-3.3-70b-versatile',\n    temperature: 0,\n    max_tokens: 400,\n    messages: [\n      { role: 'system', content: \"Eres el asistente de reportes de NutriAnimales S.A. Conviertes la pregunta del gerente en UNA sola consulta SQL de PostgreSQL. Reglas estrictas: 1) Solo SELECT. 2) Usa unicamente las vistas del esquema reportes: reportes.v_ventas_mensuales(mes,linea,num_ventas,sacos,monto_total), reportes.v_top_clientes(cliente_id,nombre,tipo,segmento,num_compras,monto_total), reportes.v_produccion_por_planta(planta,mes,estado,lotes,sacos), reportes.v_inventario_critico(nombre,categoria,stock_actual,stock_minimo,proveedor,bajo_minimo), reportes.v_calidad_por_lote(lote,producto,parametro,valor_obtenido,valor_esperado,aprobado), reportes.v_gastos_mensuales(mes,categoria,monto_total,registros). 3) Agrega siempre LIMIT 50 si no hay agregacion. 4) No uses punto y coma ni comentarios. 5) Responde solo con el SQL, sin explicaciones ni formato Markdown.\" },\n      { role: 'user', content: r.pregunta },\n    ],\n  },\n} }];"
      },
      "id": "f9faf26c-378d-43d2-b802-b9d6429827c9",
      "name": "Preparar prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "b6dc4db0-bb66-4062-9fe7-f7053ba8db24",
      "name": "Groq · generar SELECT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-groq",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $items(\"Preparar prompt\")[0].json;\nconst resp = $input.first().json;\nlet sql = '';\ntry { sql = resp.choices[0].message.content.trim(); } catch (e) { sql = ''; }\nsql = sql.replace(/^```sql/i, '').replace(/```$/,'').trim();\n// Debe ser un unico SELECT, sin separadores ni verbos de escritura.\nconst unaSentencia = !sql.includes(';');\nconst empiezaSelect = /^select\\b/i.test(sql) || /^with\\b/i.test(sql);\nconst sinEscritura = !/\\b(insert|update|delete|drop|alter|truncate|grant|revoke|create|copy|call|merge)\\b/i.test(sql);\nconst soloReportes = !/\\bfrom\\b\\s+(?!reportes\\.)/i.test(sql) ? true : /from\\s+reportes\\./i.test(sql);\nconst valido = sql.length > 0 && unaSentencia && empiezaSelect && sinEscritura;\nreturn [{ json: {\n  chat_id: prev.chat_id, usuario: prev.usuario, pregunta: prev.pregunta,\n  sql, valido,\n  b64: Buffer.from(sql, 'utf8').toString('base64'),\n} }];"
      },
      "id": "61eb1b2b-da69-45f8-87fa-945bcbe25a8a",
      "name": "Validar SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    },
    {
      "parameters": {
