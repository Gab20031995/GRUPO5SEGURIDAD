        "postgres": {
          "id": "cred-pg-agente",
          "name": "PG Agente IA (agente_ia)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const info = $items(\"Validar SQL\")[0].json;\nconst filas = $input.all().map(i => i.json);\nlet cuerpo;\nif (!filas.length) {\n  cuerpo = 'Sin resultados para la consulta.';\n} else {\n  const cols = Object.keys(filas[0]);\n  cuerpo = filas.slice(0, 20).map(f => cols.map(c => `${c}: ${f[c]}`).join(' · ')).join('\\n');\n  if (filas.length > 20) cuerpo += `\\n… (${filas.length - 20} filas más)`;\n}\nreturn [{ json: { chat_id: info.chat_id,\n  texto: `📊 NutriAnimales S.A.\\nConsulta: ${info.pregunta}\\n\\n${cuerpo}` } }];"
      },
      "id": "b315d082-29f4-4c94-a36c-417aea3b8806",
      "name": "Formatear resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
