    {
      "parameters": {
        "jsCode": "// Solo pasan filas con una alerta nueva (la BD ya deduplicó).\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (j.texto && j.chat_id && j.chat_id !== '0') {\n    out.push({ json: { chat_id: j.chat_id, codigo: j.codigo, texto: String(j.texto).slice(0, 4000) } });\n  }\n}\nreturn out;"
      },
      "id": "2e62194a-0a93-47c6-af3a-957d4bee6b39",
      "name": "Filtrar alertas nuevas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        760
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
